{
  "openapi": "3.0.3",
  "info": {
    "title": "A API do projeto",
    "description": "Toda rota aparece aqui, com o que recebe e o que devolve.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/saude": {
      "get": {
        "summary": "Confere se a API está no ar",
        "tags": [
          "sistema"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "hora": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "hora"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/negocio": {
      "get": {
        "summary": "Os dados do jogo: o nome, a frase e os links (o código-fonte e o original)",
        "tags": [
          "negócio"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nome": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frase": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nome": {
                            "type": "string",
                            "minLength": 1
                          },
                          "endereco": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "nome",
                          "endereco"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "nome",
                    "frase",
                    "links"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
